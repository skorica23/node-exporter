receivers:
  prometheus:
    config:
      scrape_configs:
        - job_name: 'node-exporter'
          scrape_interval: 15s
          static_configs:
            - targets: ['{{ node_exporter_endpoint }}']
              labels:
                instance: '{{ ansible_hostname }}'
                environment: 'production'
                cluster: '{{ cluster_name }}'
                datacenter: '{{ datacenter }}'



processors:
  batch:
    timeout: 10s
    send_batch_size: 1024
  
  memory_limiter:
    check_interval: 1s
    limit_mib: 512
  
  resourcedetection:
    detectors: [system, env]
    system:
      hostname_sources: ["os"]

  # Add resource attributes to all metrics
  resource:
    attributes:
      - key: service.name
        value: node-exporter
        action: upsert
      - key: cluster.name
        value: {{ cluster_name }}
        action: upsert

exporters:
  # Prometheus Remote Write exporter
  prometheusremotewrite:
    endpoint: {{ prometheus_remote_write_endpoint }}
    # Uncomment if your Prometheus requires authentication
    # auth:
    #   authenticator: basicauth
    timeout: 30s
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 30s
      max_elapsed_time: 300s

  # otlp:
  #   endpoint: {{ otlp_endpoint }}
  #   tls:
  #     insecure: {{ otlp_insecure | lower }}
  
  # Debug exporter (optional, useful for testing)
  logging:
    verbosity: detailed
    sampling_initial: 5
    sampling_thereafter: 200

# Uncomment if using basic auth for Prometheus
# extensions:
#   basicauth:
#     client_auth:
#       username: {{ prometheus_remote_write_username }}
#       password: {{ prometheus_remote_write_password }}

service:
  # Uncomment if using basic auth
  # extensions: [basicauth]  
  pipelines:
    metrics:
      receivers: [prometheus]
      processors: [memory_limiter, resourcedetection, resource, batch]
      exporters: [prometheusremotewrite, logging]
  
  telemetry:
    logs:
      level: info
    metrics:
      level: detailed
      address: 0.0.0.0:8888